{
    "name": "klaviyo/magento2-extension",
    "description": "Klaviyo extension for Magento 2. Allows pushing newsletters to Klaviyo's platform and more.",
    "type": "magento2-module",
    "version": "5.2.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Klaviyo\\Reclaim\\": ""
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": "^8.1",
        "magento/module-quote": ">=101.1.3",
        "ext-curl": "*",
        "giggsey/libphonenumber-for-php": "^9.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    }
}
